PROJECT_NAME           = "Trading Strategy Backtester"
PROJECT_NUMBER         = "@PROJECT_VERSION@"
PROJECT_BRIEF          = "C++17 moving-average backtesting engine"
OUTPUT_DIRECTORY       = "@PROJECT_BINARY_DIR@/docs"
INPUT                  = "@PROJECT_SOURCE_DIR@/include" "@PROJECT_SOURCE_DIR@/docs/mainpage.md"
RECURSIVE              = YES
FILE_PATTERNS          = *.hpp *.md
USE_MDFILE_AS_MAINPAGE  = "@PROJECT_SOURCE_DIR@/docs/mainpage.md"
OUTPUT_LANGUAGE        = English
EXTRACT_ALL            = NO
GENERATE_HTML          = YES
GENERATE_LATEX         = NO
HTML_OUTPUT            = html
HAVE_DOT               = NO
QUIET                  = YES
WARNINGS               = YES
WARN_IF_UNDOCUMENTED   = YES
WARN_AS_ERROR          = YES
FULL_PATH_NAMES        = NO
JAVADOC_AUTOBRIEF      = YES
